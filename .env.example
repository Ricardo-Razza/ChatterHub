# Copie para .env e preencha. NUNCA commite o .env.

# --- Banco (MySQL do docker-compose) ---
DB_NAME=razzacorddb
DB_USER=razzacord
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-senha-root

# --- API ---
# Segredo do JWT: no mínimo 32 caracteres aleatórios (ex.: openssl rand -base64 48)
JWT_SECRET=
# Origem pública do site (exatamente como o navegador acessa), separadas por vírgula
CORS_ALLOWED_ORIGINS=https://razzacord.exemplo.com

# --- WebRTC (TURN) ---
# Sem TURN, quem está atrás de NAT simétrico/4G/rede corporativa fica sem áudio.
# Gere com: openssl rand -hex 32
TURN_SECRET=
TURN_REALM=razzacord.exemplo.com
# IP público do servidor (o coturn precisa dele atrás de NAT/VPS)
TURN_EXTERNAL_IP=0.0.0.0
# URLs entregues aos clientes (ajuste o host)
TURN_URLS=turn:razzacord.exemplo.com:3478?transport=udp,turn:razzacord.exemplo.com:3478?transport=tcp
STUN_URLS=stun:razzacord.exemplo.com:3478

# --- SFU (LiveKit) opcional ---
# Com estas três variáveis a mídia passa pelo servidor (escala para salas maiores). Sem elas, malha P2P.
# O segredo precisa ter pelo menos 32 caracteres (openssl rand -hex 32).
LIVEKIT_URL=wss://livekit.exemplo.com
LIVEKIT_API_KEY=razzacord
LIVEKIT_API_SECRET=
