{
  "name": "chatterhub-desktop",
  "version": "1.1.0",
  "description": "ChatterHub Desktop Application",
  "main": "main.js",
  "author": "ChatterHub Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": ["chat", "voice", "webrtc", "electron", "chatterhub"],
  "dependencies": {
    "application-loopback": "1.2.7"
  },
  "optionalDependencies": {
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.razzadev.chatterhub",
    "productName": "ChatterHub",
    "files": [
      "main.js",
      "preload.js",
      "app-audio.js",
      "push-to-talk.js",
      "offline.html",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/application-loopback/bin/**/*",
      "node_modules/uiohook-napi/**/*"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
