{
  "name": "razzacord-desktop",
  "version": "1.1.0",
  "description": "Razzacord Desktop Application",
  "main": "main.js",
  "author": "Razzacord Team",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": ["chat", "voice", "webrtc", "electron", "razzacord"],
  "dependencies": {
    "application-loopback": "1.2.7",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.razzadev.razzacord",
    "productName": "Razzacord",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "files": [
      "main.js",
      "preload.js",
      "app-audio.js",
      "push-to-talk.js",
      "offline.html",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/application-loopback/bin/**/*"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icon.png",
      "signAndEditExecutable": false
    },
    "publish": {
      "provider": "github",
      "owner": "Ricardo-Razza",
      "repo": "ChatterHub"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.png",
      "uninstallerIcon": "assets/icon.png",
      "installerHeaderIcon": "assets/icon.png"
    }
  }
}
